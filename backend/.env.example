# King Office — fully local configuration
# Copy this file to backend/.env only when you need to override defaults.

ENVIRONMENT=local

# The default works without this variable and creates:
# backend/data/king_office.sqlite3
DATABASE_URL=sqlite:///data/king_office.sqlite3

# Change this value before entering real information.
SECRET_KEY=CHANGE_THIS_LOCAL_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173

# First local administrator. Leave password empty to generate it automatically.
# The generated credentials are written once to:
# backend/logs/FIRST_LOGIN_ADMIN_PASSWORD.txt
ADMIN_EMAIL=admin@kingoffice.local
ADMIN_INITIAL_PASSWORD=

SERVE_FRONTEND=true
BACKUP_DIR=
LOG_LEVEL=INFO

# Optional integrations are disabled by default.
TELEGRAM_LINK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=
ADMIN_NOTIFY_EMAIL=
