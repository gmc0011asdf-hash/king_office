# ==============================================================================
# King Office — Backend Configuration Template
# ==============================================================================
# 1. Copy this file to backend/.env
# 2. Fill in your actual values
# 3. NEVER commit backend/.env to Git
#
# Render deployment: set these as Environment Variables in the Render dashboard.
# Local dev/testing: fill backend/.env with the values below.
# ==============================================================================

# --- Environment ---
# Use "production" when connecting to Render/Supabase locally for testing.
# Use "development" for a fully local setup (local DB, localhost frontend).
ENVIRONMENT=development

# --- Database ---
# Local:       postgresql://postgres:postgres@localhost:5432/king_office_new
# Production:  Use the Supabase external connection string from Render dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/king_office_new

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing SECRET_KEY in production invalidates all FTTH encrypted credentials.
SECRET_KEY=REPLACE_WITH_SECURE_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Production origins — set in Render dashboard:
#   https://kingoffice.store,https://www.kingoffice.store,https://my-web-app-cyyv.onrender.com,https://king-office.onrender.com
# Add localhost entries only for local testing sessions:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend URL ---
# Used in password-reset email links.
# Production: https://kingoffice.store
# Local:      http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Email (Resend API) ---
# 1. سجّل على https://resend.com واحصل على API Key
# 2. أضف الدومين الخاص بك وتحقق منه في لوحة Resend
# 3. MAIL_FROM يجب أن يكون من الدومين المُتحقق منه (ليس Gmail)
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
MAIL_FROM=noreply@your-verified-domain.com

# --- Integrations ---
# Required in production. Used by Telegram/n8n integration.
TELEGRAM_LINK_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- Admin Seed (first bootstrap only) ---
ADMIN_EMAIL=admin@maktabalmalik.com
ADMIN_INITIAL_PASSWORD=

# --- Optional ---
SENTRY_DSN=
ADMIN_NOTIFY_EMAIL=
