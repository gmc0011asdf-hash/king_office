      "parameters": {
        "jsCode": "return items.map(item => {\n  const message = item.json.message || {};\n  const from = message.from || {};\n  const chat = message.chat || {};\n  const text = (message.text || '').trim();\n\n  const isPhone = /^07\\d{9}$/.test(text);\n  const displayName = [from.first_name || '', from.last_name || ''].join(' ').trim() || from.username || '';\n\n  return {\n    json: {\n      telegram_chat_id: chat.id || null,\n      telegram_first_name: from.first_name || '',\n      telegram_last_name: from.last_name || '',\n      telegram_username: from.username || '',\n      telegram_display_name: displayName,\n      text,\n      is_start: text === '/start',\n      is_phone: isPhone,\n      phone: isPhone ? text : null,\n      user_code: !isPhone && text !== '/start' ? text : null,\n    }\n  };\n});"
      },
