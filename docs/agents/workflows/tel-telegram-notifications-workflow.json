    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH phones AS (\n  SELECT COALESCE(NULLIF(TRIM(name), ''), '—') AS label,\n         phone_number,\n         sequence,\n         id\n  FROM internet_phones\n  ORDER BY sequence NULLS LAST, id\n  LIMIT 30\n),\nagg AS (\n  SELECT string_agg('• ' || label || ': ' || phone_number, E'\\n' ORDER BY sequence NULLS LAST, id) AS block\n  FROM phones\n)\nSELECT DISTINCT s.telegram_chat_id,\n       COALESCE(agg.block, 'لا توجد أرقام في دليل الهاتف حالياً.') AS phones_block\nFROM subscribers s\nCROSS JOIN agg\nWHERE s.telegram_chat_id IS NOT NULL;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -400,
        400
