      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, real_name, phone, user_code, expiration_date, telegram_chat_id\nFROM subscribers\nWHERE telegram_chat_id IS NOT NULL\n  AND expiration_date IS NOT NULL\n  AND expiration_date BETWEEN CURRENT_DATE\n      AND (CURRENT_DATE + ($1::int * INTERVAL '1 day'))\nORDER BY expiration_date;",
        "options": {
          "queryReplacement": "={{ [$json.expiry_warn_days] }}"
        }
